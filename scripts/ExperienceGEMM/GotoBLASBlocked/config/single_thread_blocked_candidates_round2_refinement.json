{
  "version": 1,
  "round_name": "round2_refinement",
  "experiment_name": "Single-thread blocked-size second-round refinement",
  "description": "Second-round single-thread local refinement around the first-round winning kernel-shape and blocked-size regions. This is not a new global search.",
  "summary_title": "Single-Thread Blocked Round 2 Refinement Summary",
  "plot_title": "Round 2 Refinement: Kernel Shape Relative To Best Custom Shape Per Workload",
  "plot_filename": "round2_refinement_relative_to_best_custom_heatmap.png",
  "output_layout": {
    "raw_dir": "output/ExperienceGEMM/GotoBLASBlocked/round2_refinement/raw",
    "summary_dir": "output/ExperienceGEMM/GotoBLASBlocked/round2_refinement/summary"
  },
  "benchmark": {
    "binary": "build/test_benchmark_large",
    "custom_impl": "omp_gotoblas_avx2",
    "baseline_impl": "blas"
  },
  "execution_protocol": {
    "timing_reps": 100,
    "perf_reps": 5,
    "benchmark_inner_reps": 1,
    "threads": 1,
    "pin_core": 0,
    "use_taskset": true,
    "enable_perf": true,
    "enable_openblas_baseline": true,
    "freq_policy": "set_if_needed",
    "governor": "performance"
  },
  "workloads": {
    "main": [
      {
        "enabled": true,
        "WorkloadFamily": "fc_forward_mainstream_nn",
