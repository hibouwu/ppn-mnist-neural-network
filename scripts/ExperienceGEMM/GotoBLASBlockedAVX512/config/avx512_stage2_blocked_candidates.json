{
  "version": 1,
  "description": "AVX-512 GotoBLAS stage-2 blocked-size candidates. Use after stage-1 kernel screening; do not treat this as a global grid recommendation.",
  "benchmark": {
    "binary": "build/test_benchmark_large",
    "custom_impl": "omp_gotoblas_avx512",
    "baseline_impl": "blas"
  },
  "execution_protocol": {
    "timing_reps": 500,
    "perf_reps": 3,
    "benchmark_inner_reps": 1,
    "threads": 1,
    "pin_core": 0,
    "use_taskset": true,
    "enable_perf": true,
    "enable_openblas_baseline": false,
    "freq_policy": "detect",
    "governor": "performance"
  },
  "workloads": {
    "main": [
      {
        "enabled": true,
        "WorkloadFamily": "fc_forward_mainstream_nn",
        "WorkloadId": "mlp_fc1_b32",
        "Size": [32, 784, 128],
        "Note": "default MLP first layer"
      },
      {
        "enabled": true,
        "WorkloadFamily": "fc_head_small_n_nn",
        "WorkloadId": "mlp_fc2_b32",
        "Size": [32, 128, 10],
        "Note": "small-N logits head"
      },
      {
        "enabled": true,
        "WorkloadFamily": "fc_wide_output_nn",
        "WorkloadId": "mlp_fc1_hidden256_b32",
        "Size": [32, 784, 256],
        "Note": "wider output"
      },
      {
        "enabled": true,
        "WorkloadFamily": "conv_dx_extremely_skinny_k_nn",
        "WorkloadId": "cnn_conv2_dX_b32",
        "Size": [3200, 16, 150],
        "Note": "skinny-K convolution-gradient-like GEMM"
      }
    ],
    "sanity": []
  },
