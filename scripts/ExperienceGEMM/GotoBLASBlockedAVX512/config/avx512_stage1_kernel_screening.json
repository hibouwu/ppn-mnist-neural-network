{
  "version": 1,
  "description": "AVX-512 GotoBLAS stage-1 kernel-shape screening. Fixed conservative blocking per primary kernel shape; no global blocked-size grid.",
  "benchmark": {
    "binary": "build/test_benchmark_large",
    "custom_impl": "omp_gotoblas_avx512",
    "baseline_impl": "blas"
  },
  "execution_protocol": {
    "timing_reps": 300,
    "perf_reps": 3,
    "benchmark_inner_reps": 1,
    "threads": 1,
    "pin_core": 0,
    "use_taskset": true,
    "enable_perf": true,
    "enable_openblas_baseline": false,
    "freq_policy": "detect",
    "governor": "performance"
  },
  "workloads": {
    "main": [
      {
        "enabled": true,
        "WorkloadFamily": "fc_forward_mainstream_nn",
        "WorkloadId": "mlp_fc1_b32",
        "Size": [32, 784, 128],
        "Note": "default MLP first layer"
      },
      {
        "enabled": true,
        "WorkloadFamily": "fc_head_small_n_nn",
        "WorkloadId": "mlp_fc2_b32",
        "Size": [32, 128, 10],
        "Note": "small-N logits head"
      },
      {
        "enabled": true,
        "WorkloadFamily": "fc_wide_output_nn",
        "WorkloadId": "mlp_fc1_hidden256_b32",
        "Size": [32, 784, 256],
        "Note": "wider output"
      },
      {
        "enabled": true,
        "WorkloadFamily": "conv_dx_extremely_skinny_k_nn",
        "WorkloadId": "cnn_conv2_dX_b32",
        "Size": [3200, 16, 150],
        "Note": "skinny-K convolution-gradient-like GEMM"
      }
    ],
    "sanity": []
  },
  "kernel_rows": [
    {
      "KernelShape": "avx512_4x16",
      "mr": 4,
      "nr": 16,
      "candidate_class": "primary",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 256, "Mc": [32], "Nc": [512] }
      ]
    },
    {
      "KernelShape": "avx512_8x16",
      "mr": 8,
      "nr": 16,
      "candidate_class": "primary",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 256, "Mc": [32], "Nc": [512] }
      ]
    },
    {
      "KernelShape": "avx512_16x16",
      "mr": 16,
      "nr": 16,
      "candidate_class": "primary",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 192, "Mc": [48], "Nc": [512] }
      ]
    },
    {
      "KernelShape": "avx512_20x16",
      "mr": 20,
      "nr": 16,
      "candidate_class": "primary",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 160, "Mc": [60], "Nc": [512] }
      ]
    },
    {
      "KernelShape": "avx512_8x32",
      "mr": 8,
      "nr": 32,
      "candidate_class": "primary",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 128, "Mc": [32], "Nc": [768] }
      ]
    },
    {
      "KernelShape": "avx512_12x32",
      "mr": 12,
      "nr": 32,
      "candidate_class": "primary",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 96, "Mc": [48], "Nc": [768] }
      ]
    },
    {
      "KernelShape": "avx512_4x32",
      "mr": 4,
      "nr": 32,
      "candidate_class": "stress_fallback",
      "current_binary_supported": true,
      "rows": [
        { "Kc": 96, "Mc": [32], "Nc": [768] }
      ]
    }
  ]
}
